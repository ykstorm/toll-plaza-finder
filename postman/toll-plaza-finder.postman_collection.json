          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and empty list', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().tollPlazas).to.be.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
