              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('Invalid source or destination pincode'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
