    {
      "name": "Island with no road connection (Port Blair)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422', () => pm.response.to.have.status(422));",
              "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('No drivable route found between the given pincodes'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourcePincode\": \"110001\",\n  \"destinationPincode\": \"744101\"\n}"
        },
        "url": {
